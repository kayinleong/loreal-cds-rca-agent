{
	"servers": {
		"snow-mcp": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": ["-u", "${workspaceFolder}/rca_copilot_agent/mcp_server.py"],
			"env": {
				"SNOW_INSTANCE": "https://loreal.service-now.com",
