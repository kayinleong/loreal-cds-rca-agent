# ══════════════════════════════════════════════════════════════════
# RCA Agent Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ── LLM Provider ─────────────────────────────────────────────────
# Switch between providers by changing LLM_PROVIDER.
# The MCP server doesn't use these — only agent_runner.py does.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=sk-ant-api03-...

# For OpenAI instead:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# For Google Gemini:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ── BigQuery ─────────────────────────────────────────────────────
BQ_PROJECT=oa-apmena-spacecds-ap-pd
BQ_DATASET=space_cds_b2c_ds_replica_ae2_pd_public
BQ_MAX_BYTES=500000000
BQ_TIMEOUT=30
BQ_MAX_ROWS=100

# ── ServiceNow (from your existing browser session) ─────────────
# SNOW_INSTANCE is passed as --snow-instance on the command line, not via .env
COOKIE=glide_sso_id=...; JSESSIONID=...; ...
X_USERTOKEN=...

SNOW_REPORTS_DIR=./my_reports
SNOW_ATTACHMENTS_DIR=./attachments

# ── Agent ────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=15
AGENT_WIKI_DIR=./wiki
AGENT_OUTPUT_DIR=./rca_reports
