# ── ServiceNow (from your existing browser session) ─────────────
# HOW TO GET: Open Chrome DevTools → Network → click any SNOW request → Request Headers
COOKIE=<paste full Cookie header value here>
X_USERTOKEN=<paste X-UserToken header value here>

REPORTS_DIR=./my_reports
ATTACHMENTS_DIR=./attachments

# ── SMTP Email Notifications ──────────────────────────────────────
# When the RCA agent finishes analysis, it calls send_rca_email to alert you.
# The email is HTML-formatted and attaches all RCA reports from the session.
#
# Common providers:
#   Gmail:     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
#              (use an App Password — not your account password)
#   Outlook:   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_TLS=true
#   SES:       SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_VERIFY_SSL=true
# Set SMTP_VERIFY_SSL=false if behind a corporate proxy that intercepts TLS (SSL cert errors)
SMTP_USER=<your-email@gmail.com>
SMTP_PASSWORD=<your-app-password>
SMTP_FROM=<your-email@gmail.com>
SMTP_TO=<recipient1@example.com>,<recipient2@example.com>
